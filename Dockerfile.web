# ---- Build stage: Flutter web ----
FROM gmeligio/flutter-android:3.47.7 AS builder

WORKDIR /app
# Image runs as flutter (uid 1001). Every COPY must chown or pub get / bake cannot write.
COPY --chown=flutter:flutter pubspec.* ./
RUN flutter pub get
RUN flutter config --enable-web
COPY --chown=flutter:flutter . .

# --dart-define=BRAND does nothing; bake active_brand.g.dart + web shell from brand/iacle.
# Requires iacle.licence in the build context (CI writes it from IACLE_BRAND_LICENCE).
RUN dart run tool/brand_codegen.dart iacle --license /app/iacle.licence

RUN flutter build web --release --no-web-resources-cdn \
 && python3 -c 'import json,pathlib; m=json.loads(pathlib.Path("assets/version.json").read_text()); p=pathlib.Path("build/web/index.html"); p.write_text(p.read_text().replace("$FLUTTER_BUILD_NUMBER", m["version"]+"."+str(m["build_number"])))'

# ---- Serve stage: Nginx ----
FROM nginx:alpine

COPY --from=builder /app/build/web /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=5 CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1
