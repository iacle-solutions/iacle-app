[Unit]
Description=IAClé Docker Admin Daemon
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/iacle
ExecStart=/bin/bash /opt/iacle/scripts/setup/docker_startup_vps.sh
ExecStop=/usr/bin/docker compose -f /opt/iacle/config/docker/docker-compose.admin.yml down

[Install]
WantedBy=multi-user.target 